@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/tib/datacite/property/relatedIdentifier> a rdf:Property ;
    rdfs:label "relatedIdentifier" ;
    rdfs:comment "Identifiers of related resources. These must be globally unique identifiers." ;
    rdfs:range <https://w3id.org/tib/datacite/class/RelatedIdentifier> ;
    skos:scopeNote "In RDF, this property links the resource to a RelatedIdentifier node; the node gives the identifier as plain text in rdf:value, alongside its relatedIdentifierType, relationType and other qualifiers." .

