@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/tib/datacite/property/relatedItem> a rdf:Property ;
    rdfs:label "relatedItem" ;
    rdfs:comment "Information about a resource related to the one being registered." ;
    rdfs:range <https://w3id.org/tib/datacite/class/RelatedItem> ;
    skos:scopeNote "In RDF, this property links the resource to a RelatedItem node, which groups the element's sub-properties." .

