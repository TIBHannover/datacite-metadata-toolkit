@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/tib/datacite/property/date> a rdf:Property ;
    rdfs:label "date" ;
    rdfs:comment "Different dates relevant to the work." ;
    rdfs:range <https://w3id.org/tib/datacite/class/Date> ;
    skos:scopeNote "In RDF, this property links the resource to a Date node; the node gives the date as plain text in rdf:value, alongside its dateType and dateInformation." .

