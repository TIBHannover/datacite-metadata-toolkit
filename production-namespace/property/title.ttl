@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/tib/datacite/property/title> a rdf:Property ;
    rdfs:label "title" ;
    rdfs:comment "A name or title by which a resource is known. May be the title of a dataset or the name of a piece of software or an instrument." .

