@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/tib/datacite/property/identifier> a rdf:Property ;
    rdfs:label "identifier" ;
    rdfs:comment "The Identifier is a unique string that identifies a resource." .

