@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/tib/datacite/property/identifier> a rdf:Property ;
    rdfs:label "identifier" ;
    rdfs:comment "The Identifier is a unique string that identifies a resource." ;
    rdfs:range <https://w3id.org/tib/datacite/class/Identifier> ;
    skos:scopeNote "In RDF, this property links the resource to an Identifier node; the node gives the identifier as plain text in rdf:value, alongside its identifierType." .

