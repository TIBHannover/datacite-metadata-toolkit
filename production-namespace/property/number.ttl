@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/tib/datacite/property/number> a rdf:Property ;
    rdfs:label "number" ;
    rdfs:comment "Number of the resource within the related item, e.g., report number or article number." .

