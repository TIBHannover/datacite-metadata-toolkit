@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/tib/datacite/property/firstPage> a rdf:Property ;
    rdfs:label "firstPage" ;
    rdfs:comment "First page of the resource within the related item, e.g., of the chapter, article, or conference paper in proceedings." .

