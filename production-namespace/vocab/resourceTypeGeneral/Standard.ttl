@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/tib/datacite/vocab/resourceTypeGeneral/Standard> a skos:Concept ;
    skos:closeMatch <https://www.dublincore.org/specifications/dublin-core/dcmi-type-vocabulary/#Text> ;
    skos:definition "Something established by authority, custom, or general consent as a model, example, or point of reference." ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/resourceTypeGeneral> ;
    skos:notation "Standard" ;
    skos:prefLabel "Standard" ;
    skos:scopeNote "<resourceType resourceTypeGeneral=\"Standard\">Dublin Core</resourceType>" ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/resourceTypeGeneral> .

