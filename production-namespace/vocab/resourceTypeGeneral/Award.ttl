    skos:notation "Award" ;
    skos:prefLabel "Award" ;
    skos:scopeNote """<resourceType resourceTypeGeneral="Award">Grant</resourceType>
<resourceType resourceTypeGeneral="Award">Facility use</resourceType>""" ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/resourceTypeGeneral> .

