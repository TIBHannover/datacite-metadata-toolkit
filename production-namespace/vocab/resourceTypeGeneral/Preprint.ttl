@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/tib/datacite/vocab/resourceTypeGeneral/Preprint> a skos:Concept ;
    skos:closeMatch <https://www.dublincore.org/specifications/dublin-core/dcmi-type-vocabulary/#Text> ;
    skos:definition "A version of a scholarly or scientific paper that precedes formal peer review and publication in a peer-reviewed scholarly or scientific journal." ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/resourceTypeGeneral> ;
    skos:notation "Preprint" ;
    skos:prefLabel "Preprint" ;
    skos:scopeNote "<resourceType resourceTypeGeneral=\"Preprint\">Research Paper</resourceType>" ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/resourceTypeGeneral> .

