@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/tib/datacite/vocab/resourceTypeGeneral/PhysicalObject> a skos:Concept ;
    skos:definition "A physical object or substance." ;
    skos:example "https://api.datacite.org/dois/application/vnd.datacite.datacite+xml/10.7299/X78052RB" ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/resourceTypeGeneral> ;
    skos:notation "PhysicalObject" ;
    skos:prefLabel "PhysicalObject" ;
    skos:scopeNote "Artifacts, specimens, material samples, and features-of-interest of any size. Digital representations of physical objects should use one of the other resourceTypeGeneral values." ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/resourceTypeGeneral> .

