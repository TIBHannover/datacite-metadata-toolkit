    skos:notation "Model" ;
    skos:prefLabel "Model" ;
    skos:scopeNote "Modelled descriptions of, for example, different aspects of languages or a molecular biology reaction chain" ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/resourceTypeGeneral> .

