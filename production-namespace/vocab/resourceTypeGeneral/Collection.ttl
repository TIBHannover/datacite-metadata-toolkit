@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/tib/datacite/vocab/resourceTypeGeneral/Collection> a skos:Concept ;
    skos:closeMatch <https://www.dublincore.org/specifications/dublin-core/dcmi-type-vocabulary/#Collection> ;
    skos:definition "An aggregation of resources, which may encompass collections of one resourceType as well as those of mixed types. A collection is described as a group; its parts may also be separately described." ;
    skos:example "https://api.datacite.org/dois/application/vnd.datacite.datacite+xml/10.1594/pangaea.877589" ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/resourceTypeGeneral> ;
    skos:notation "Collection" ;
    skos:prefLabel "Collection" ;
    skos:scopeNote "A collection of samples, or various files making up a report" ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/resourceTypeGeneral> .

