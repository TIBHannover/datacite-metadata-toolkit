@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/tib/datacite/vocab/resourceTypeGeneral/DataPaper> a skos:Concept ;
    skos:closeMatch <https://www.dublincore.org/specifications/dublin-core/dcmi-type-vocabulary/#Text> ;
    skos:definition "A factual and objective publication with a focused intent to identify and describe specific data, sets of data, or data collections to facilitate discoverability." ;
    skos:example "https://api.datacite.org/dois/application/vnd.datacite.datacite+xml/10.17912/w2mw2d" ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/resourceTypeGeneral> ;
    skos:notation "DataPaper" ;
    skos:prefLabel "DataPaper" ;
    skos:scopeNote "A data paper describes data provenance and methodologies used in the gathering, processing, organizing, and representing the data" ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/resourceTypeGeneral> .

