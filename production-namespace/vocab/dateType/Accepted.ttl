@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/tib/datacite/vocab/dateType/Accepted> a skos:Concept ;
    skos:definition "The date that the publisher accepted the resource into their system." ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/dateType> ;
    skos:notation "Accepted" ;
    skos:prefLabel "Accepted" ;
    skos:scopeNote "To indicate the start of an embargo period, use Accepted or Submitted, as appropriate." ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/dateType> .

