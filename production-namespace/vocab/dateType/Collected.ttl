@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/tib/datacite/vocab/dateType/Collected> a skos:Concept ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    skos:changeNote "Added/updated Czech translation for prefLabel and/or definition (2026-09-18)"@en ;
    skos:definition "Datum nebo časové rozmezí, ve kterém byl shromážděn obsah zdroje."@cs,
        "The date or date range in which the resource content was collected."@en ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/dateType> ;
    skos:notation "Collected" ;
    skos:prefLabel "Datum sběru"@cs,
        "Collected"@en ;
    skos:scopeNote "To indicate precise or particular timeframes in which research was conducted." ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/dateType> .

