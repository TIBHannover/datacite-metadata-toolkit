@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/tib/datacite/vocab/dateType/Updated> a skos:Concept ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    skos:changeNote "Added/updated Czech translation for prefLabel and/or definition (2026-09-18)"@en ;
    skos:definition "Datum poslední aktualizace zdroje. Může se jednat i o časové rozmezí."@cs,
        "The date of the last update to the resource, when the resource is being added to. May be a range."@en ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/dateType> ;
    skos:notation "Updated" ;
    skos:prefLabel "Datum aktualizace"@cs,
        "Updated"@en ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/dateType> .

