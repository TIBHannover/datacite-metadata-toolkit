@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/tib/datacite/vocab/relationType/IsVersionOf> a skos:Concept ;
    skos:definition "indicates A is a version of B" ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"DOI\" relationType=\"IsVersionOf\">10.5281/ZENODO.832054</relatedIdentifier>" ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/relationType> ;
    skos:notation "IsVersionOf" ;
    skos:prefLabel "IsVersionOf" ;
    skos:scopeNote "The registered resource is an instance of a target resource (A is an instance of B). May relate a specific software version to its code repository." ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/relationType> .

