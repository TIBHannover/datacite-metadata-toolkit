@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/tib/datacite/vocab/relationType/IsOriginalFormOf> a skos:Concept ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    skos:changeNote "Added/updated Czech translation for prefLabel and/or definition (2026-09-18)"@en ;
    skos:definition "označuje, že A je původní variantou B"@cs,
        "indicates A is the original form of B"@en ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"DOI\" relationType=\"IsOriginalFormOf\">10.1234/9035</relatedIdentifier>" ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/relationType> ;
    skos:notation "IsOriginalFormOf" ;
    skos:prefLabel "je původní variantou (čeho)"@cs,
        "IsOriginalFormOf"@en ;
    skos:scopeNote "May be used for different software operating systems or compiler formats." ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/relationType> .

