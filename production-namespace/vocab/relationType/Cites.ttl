@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/tib/datacite/vocab/relationType/Cites> a skos:Concept ;
    skos:definition "indicates that A includes B in a citation" ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"ISBN\" relationType=\"Cites\">0761964312</relatedIdentifier>" ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/relationType> ;
    skos:notation "Cites" ;
    skos:prefLabel "Cites" ;
    skos:scopeNote "Recommended for discovery." ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/relationType> .

