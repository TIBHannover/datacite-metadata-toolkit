@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/tib/datacite/vocab/relationType/IsSourceOf> a skos:Concept ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    skos:changeNote "Added/updated Czech translation for prefLabel and/or definition (2026-09-18)"@en ;
    skos:definition "označuje, že A je zdrojem, na kterém je B založen"@cs,
        "indicates A is a source upon which B is based"@en ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"URL\" relationType=\"IsSourceOf\">http://opencontext.org/projects/81204AF8-127C-4686-E9B0-1202C3A47959</relatedIdentifier>" ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/relationType> ;
    skos:notation "IsSourceOf" ;
    skos:prefLabel "je zdrojem odvozené verze"@cs,
        "IsSourceOf"@en ;
    skos:scopeNote "IsSourceOf is the original resource from which a derivative resource was created (e.g., original dataset without value manipulation)." ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/relationType> .

