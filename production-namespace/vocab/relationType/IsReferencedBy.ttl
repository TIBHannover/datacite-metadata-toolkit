@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/tib/datacite/vocab/relationType/IsReferencedBy> a skos:Concept ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    skos:changeNote "Added/updated Czech translation for prefLabel and/or definition (2026-09-18)"@en ;
    skos:definition "označuje, že na A je odkazován z B"@cs,
        "indicates A is used as a source of information by B"@en ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"URL\" relationType=\"IsReferencedBy\">http://www.testpubl.de</relatedIdentifier>" ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/relationType> ;
    skos:notation "IsReferencedBy" ;
    skos:prefLabel "je na něj odkazováno z (čeho)"@cs,
        "IsReferencedBy"@en ;
    skos:scopeNote "Recommended for discovery." ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/relationType> .

