@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/tib/datacite/vocab/relationType/IsIdenticalTo> a skos:Concept ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    skos:changeNote "Added/updated Czech translation for prefLabel and/or definition (2026-09-18)"@en ;
    skos:definition "označuje, že A je identické s B (použije se v případě potřeby zaregistrovat dvě samostatné instance téhož zdroje)"@cs,
        "indicates that A is identical to B, for use when there is a need to register two separate instances of the same resource"@en ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"URL\" relationType=\"IsIdenticalTo\">http://oac.cdlib.org/findaid/ark:/13030/c8r78fzq</relatedIdentifier>" ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/relationType> ;
    skos:notation "IsIdenticalTo" ;
    skos:prefLabel "je identický s"@cs,
        "IsIdenticalTo"@en ;
    skos:scopeNote "Use when the same resource is saved in another location (e.g., another institution)." ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/relationType> .

