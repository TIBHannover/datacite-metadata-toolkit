@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/tib/datacite/vocab/relationType/IsPublishedIn> a skos:Concept ;
    skos:definition "indicates A is published inside B, but is independent of other things published inside of B" ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"ISSN\" relationType=\"IsPublishedIn\">2213-1337</relatedIdentifier>" ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/relationType> ;
    skos:notation "IsPublishedIn" ;
    skos:prefLabel "IsPublishedIn" ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/relationType> .

