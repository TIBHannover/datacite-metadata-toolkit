@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/tib/datacite/vocab/relationType/Other> a skos:Concept ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    skos:changeNote "Added/updated Czech translation for prefLabel and/or definition (2026-09-18)"@en ;
    skos:definition "označuje, že A souvisí s B a tento vztah neodpovídá žádné z existujících kategorií"@cs,
        "indicates that A is related to B and the relationship does not fit into an existing category"@en ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"DOI\" relationType=\"Other\" relationTypeInformation=\"is output of\" resourceTypeGeneral=\"Project\">10.21384/p27z-6n52</relatedIdentifier>" ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/relationType> ;
    skos:notation "Other" ;
    skos:prefLabel "jiná role"@cs,
        "Other"@en ;
    skos:scopeNote "If selected, supply a value for relationTypeInformation describing the nature of the relationship; applies to both relatedIdentifier and relatedItem." ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/relationType> .

