@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/tib/datacite/vocab/relationType/IsRequiredBy> a skos:Concept ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    skos:changeNote "Added/updated Czech translation for prefLabel and/or definition (2026-09-18)"@en ;
    skos:definition "označuje, že A je vyžadován entitou B"@cs,
        "Indicates A is required by B"@en ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"DOI\" relationType=\"IsRequiredBy\">10.1234/8675</relatedIdentifier>" ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/relationType> ;
    skos:notation "IsRequiredBy" ;
    skos:prefLabel "je požadován (čím)"@cs,
        "IsRequiredBy"@en ;
    skos:scopeNote "May be used to indicate software dependencies." ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/relationType> .

