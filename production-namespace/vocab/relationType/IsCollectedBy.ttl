@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/tib/datacite/vocab/relationType/IsCollectedBy> a skos:Concept ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    skos:changeNote "Added/updated Czech translation for prefLabel and/or definition (2026-09-18)"@en ;
    skos:definition "označuje, že A je sbírán/shromažďován entitou B"@cs,
        "Indicates A is collected by B"@en ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"DOI\" relationType=\"IsCollectedBy\">10.5072/instrument</relatedIdentifier>" ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/relationType> ;
    skos:notation "IsCollectedBy" ;
    skos:prefLabel "je sbírán (čím)"@cs,
        "IsCollectedBy"@en ;
    skos:scopeNote "May indicate relationship between a dataset and an instrument used to collect/measure/observe data." ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/relationType> .

