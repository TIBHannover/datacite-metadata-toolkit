@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/tib/datacite/vocab/relationType/IsCitedBy> a skos:Concept ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    skos:changeNote "Added/updated Czech translation for prefLabel and/or definition (2026-09-18)"@en ;
    skos:definition "označuje, že B cituje A"@cs,
        "indicates that B includes A in a citation"@en ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"DOI\" relationType=\"IsCitedBy\">10.4232/10.ASEAS-5.2-1</relatedIdentifier>" ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/relationType> ;
    skos:notation "IsCitedBy" ;
    skos:prefLabel "je citován (čím)"@cs,
        "IsCitedBy"@en ;
    skos:scopeNote "Recommended for discovery." ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/relationType> .

