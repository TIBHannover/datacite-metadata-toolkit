{
  "@context": "./context.jsonld",
  "id": "https://w3id.org/tib/datacite/vocab/relationType/IsIdenticalTo",
  "type": "Concept",
  "prefLabel": [
    {
      "@language": "en",
      "@value": "IsIdenticalTo"
    },
    {
      "@language": "cs",
      "@value": "je identický s"
    }
  ],
  "notation": "IsIdenticalTo",
  "definition": [
    {
      "@language": "en",
      "@value": "indicates that A is identical to B, for use when there is a need to register two separate instances of the same resource"
    },
    {
      "@language": "cs",
      "@value": "označuje, že A je identické s B (použije se v případě potřeby zaregistrovat dvě samostatné instance téhož zdroje)"
    }
  ],
  "inScheme": "https://w3id.org/tib/datacite/vocab/relationType",
  "topConceptOf": "https://w3id.org/tib/datacite/vocab/relationType",
  "scopeNote": "Use when the same resource is saved in another location (e.g., another institution).",
  "example": [
    "<relatedIdentifier relatedIdentifierType=\"URL\" relationType=\"IsIdenticalTo\">http://oac.cdlib.org/findaid/ark:/13030/c8r78fzq</relatedIdentifier>"
  ],
  "modified": "2026-09-18",
