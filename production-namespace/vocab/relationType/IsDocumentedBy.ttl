@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/tib/datacite/vocab/relationType/IsDocumentedBy> a skos:Concept ;
    skos:definition "indicates B is documentation about/explaining A" ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"URL\" relationType=\"IsDocumentedBy\">http://tobias-lib.uni-tuebingen.de/volltexte/2000/96/</relatedIdentifier>" ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/relationType> ;
    skos:notation "IsDocumentedBy" ;
    skos:prefLabel "IsDocumentedBy" ;
    skos:scopeNote "May be used for software documentation." ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/relationType> .

