@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/tib/datacite/vocab/titleType/AlternativeTitle> a skos:Concept ;
    skos:definition "A title by which the resource is also known, used as an alternative to the primary title." ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/titleType> ;
    skos:notation "AlternativeTitle" ;
    skos:prefLabel "AlternativeTitle" ;
    skos:scopeNote "Use for formally recognized alternate titles. For translated titles use TranslatedTitle; for secondary titles use Subtitle." ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/titleType> .

