@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/tib/datacite/vocab/titleType/Other> a skos:Concept ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    skos:changeNote "Added/updated Czech translation for prefLabel and/or definition (2026-09-18)"@en ;
    skos:definition "Jakýkoli typ názvu, který není pokryt jinými hodnotami v řízeném slovníku titleType."@cs,
        "Any title type not covered by the other values in the titleType controlled list."@en ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/titleType> ;
    skos:notation "Other" ;
    skos:prefLabel "Jiný"@cs,
        "Other"@en ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/titleType> .

