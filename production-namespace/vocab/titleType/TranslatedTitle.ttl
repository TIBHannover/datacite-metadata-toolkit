@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/tib/datacite/vocab/titleType/TranslatedTitle> a skos:Concept ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    skos:changeNote "Added/updated Czech translation for prefLabel and/or definition (2026-09-18)"@en ;
    skos:definition "Název, který je překladem primárního názvu do jiného jazyka."@cs,
        "A title that is a translation of the primary title into another language."@en ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/titleType> ;
    skos:notation "TranslatedTitle" ;
    skos:prefLabel "Přeložený název"@cs,
        "TranslatedTitle"@en ;
    skos:scopeNote "Use the xml:lang attribute to indicate the language of the translated title." ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/titleType> .

