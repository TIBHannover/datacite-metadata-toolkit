@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/tib/datacite/vocab/relatedIdentifierType/URN> a skos:Concept ;
    skos:altLabel "Uniform Resource Name" ;
    skos:definition "A unique and persistent identifier of an electronic document. The syntax is: urn:<NID>:<NSS>. The leading urn: sequence is case-insensitive, <NID> is the namespace identifier, <NSS> is the namespace-specific string." ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"URN\" relationType=\"IsSupplementTo\">urn:nbn:de:101:1-201102033592</relatedIdentifier>" ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/relatedIdentifierType> ;
    skos:notation "URN" ;
    skos:prefLabel "URN" ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/relatedIdentifierType> .

