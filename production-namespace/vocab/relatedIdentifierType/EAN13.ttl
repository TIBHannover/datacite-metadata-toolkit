@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/tib/datacite/vocab/relatedIdentifierType/EAN13> a skos:Concept ;
    skos:altLabel "European Article Number (now renamed International Article Number, but retaining the original acronym)" ;
    skos:definition "A 13-digit barcoding standard that is a superset of the original 12-digit Universal Product Code (UPC) system." ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"EAN13\" relationType=\"Cites\">9783468111242</relatedIdentifier>" ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/relatedIdentifierType> ;
    skos:notation "EAN13" ;
    skos:prefLabel "EAN13" ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/relatedIdentifierType> .

