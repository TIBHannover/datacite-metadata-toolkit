@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/tib/datacite/vocab/contributorType/Translator> a skos:Concept ;
    skos:definition "A person, organization, or automated system responsible for converting the content of a resource from one language into another, preserving its meaning and intended message." ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/contributorType> ;
    skos:notation "Translator" ;
    skos:prefLabel "Translator" ;
    skos:scopeNote "Apply to DOI metadata for a resource which has been translated from another resource." ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/contributorType> .

