@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/tib/datacite/vocab/contributorType/ProjectManager> a skos:Concept ;
    skos:definition "Person officially designated as manager of a project. Project may consist of one or many project teams and sub-teams." ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/contributorType> ;
    skos:notation "ProjectManager" ;
    skos:prefLabel "ProjectManager" ;
    skos:scopeNote "The manager of a project normally has more administrative responsibility than actual work involvement." ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/contributorType> .

