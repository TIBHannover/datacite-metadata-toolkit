@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/tib/datacite/vocab/contributorType/ProjectMember> a skos:Concept ;
    skos:definition "Person on the membership list of a designated project/project team." ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/contributorType> ;
    skos:notation "ProjectMember" ;
    skos:prefLabel "ProjectMember" ;
    skos:scopeNote "This vocabulary may or may not indicate the quality, quantity, or substance of the person’s involvement." ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/contributorType> .

