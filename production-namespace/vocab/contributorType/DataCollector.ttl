@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/tib/datacite/vocab/contributorType/DataCollector> a skos:Concept ;
    skos:definition "Person/institution responsible for finding or gathering/collecting data under the guidelines of the author(s) or Principal Investigator (PI)." ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/contributorType> ;
    skos:notation "DataCollector" ;
    skos:prefLabel "DataCollector" ;
    skos:scopeNote "May also be used when crediting survey conductors, interviewers, event or condition observers, or persons responsible for monitoring key instrument data." ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/contributorType> .

