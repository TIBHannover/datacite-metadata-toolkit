@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/tib/datacite/vocab/descriptionType/TableOfContents> a skos:Concept ;
    skos:definition "A listing of the Table of Contents." ;
    skos:example "https://data.datacite.org/application/vnd.datacite.datacite+xml/10.5678/LCRS/FOR816.CIT.1031" ;
    skos:inScheme <https://w3id.org/tib/datacite/vocab/descriptionType> ;
    skos:notation "TableOfContents" ;
    skos:prefLabel "TableOfContents" ;
    skos:scopeNote "Use “<br>” to indicate a line break for improved rendering of multiple paragraphs, but otherwise no html markup." ;
    skos:topConceptOf <https://w3id.org/tib/datacite/vocab/descriptionType> .

