  "notation": "TechnicalInfo",
  "definition": [
    {
      "@language": "en",
      "@value": "Detailed information that may be associated with design, implementation, operation, use, and/or maintenance of a process, system, or instrument."
    },
    {
      "@language": "cs",
      "@value": "Podrobné informace, které mohou souviset s návrhem, implementací, provozem, použitím a/nebo údržbou systému nebo přístroje nebo jiným nastavením procesu získání či ověření datasetu či jiného zdroje."
    }
  ],
  "inScheme": "https://w3id.org/tib/datacite/vocab/descriptionType",
  "topConceptOf": "https://w3id.org/tib/datacite/vocab/descriptionType",
  "scopeNote": "For software description, this may include the contents of a “readme.txt” and necessary environmental information (hardware, operational software, applications/programs with version information, a human-readable synopsis of software purpose) that cannot be described using other properties. For other uses, this can include specific and detailed information as necessary and appropriate.",
  "modified": "2026-09-18",
  "changeNote": [
    "Added/updated Czech translation for prefLabel and/or definition (2026-09-18)"
  ]
}