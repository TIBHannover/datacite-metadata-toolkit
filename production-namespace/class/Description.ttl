@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/tib/datacite/class/Description> a rdfs:Class ;
    rdfs:label "Description" ;
    rdfs:comment " All additional information that does not fit in any of the other categories. May be used for technical information or detailed information associated with a scientific instrument." .

