  "notation": "Created",
  "definition": [
    {
      "@language": "en",
      "@value": "The date the resource itself was put together; this could refer to a timeframe in ancient history, a date range, or a single date for a final component, e.g., the finalised file with all the data."
    },
    {
      "@language": "cs",
      "@value": "Datum, kdy byl zdroj sestaven; může se jednat o datum nebo časové rozmezí v minulosti, nebo o časové rozmezí či datum, kdy byl zdroj finálně zkompletován. \nDoporučeno použít pro lepší vyhledávání."
    }
  ],
  "inScheme": "https://schema.stage.datacite.org/linked-data/vocab/dateType",
  "topConceptOf": "https://schema.stage.datacite.org/linked-data/vocab/dateType",
  "scopeNote": "Recommended for discovery.",
