  "notation": "Submitted",
  "definition": [
    {
      "@language": "en",
      "@value": "The date the creator submits the resource to the publisher. This could be different from Accepted if the publisher then applies a selection process."
    },
    {
      "@language": "cs",
      "@value": "Datum, kdy tvůrce odešle (odevzdá) zdroj vydavateli. Toto datum se může lišit od Data přijetí, pokud vydavatel následně uplatní recenzní proces nebo jiný proces výběru.\nDoporučeno použít pro lepší vyhledávání."
    }
  ],
  "inScheme": "https://schema.stage.datacite.org/linked-data/vocab/dateType",
  "topConceptOf": "https://schema.stage.datacite.org/linked-data/vocab/dateType",
  "scopeNote": "Recommended for discovery. To indicate the start of an embargo period, use Submitted or Accepted, as appropriate.",
