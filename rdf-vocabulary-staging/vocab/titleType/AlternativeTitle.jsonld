  "definition": [
    {
      "@language": "en",
      "@value": "A title by which the resource is also known, used as an alternative to the primary title."
    },
    {
      "@language": "cs",
      "@value": "Název, pod kterým je zdroj také známý, používaný jako alternativa k primárnímu názvu."
    }
  ],
  "scopeNote": "Use for formally recognized alternate titles. For translated titles use TranslatedTitle; for secondary titles use Subtitle.",
