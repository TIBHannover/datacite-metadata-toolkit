{
  "@context": {
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "schema": "https://schema.stage.datacite.org/linked-data/",
    "datacite": "https://schema.stage.datacite.org/linked-data/",
    "skos": "http://www.w3.org/2004/02/skos/core#"
  },
  "@id": "https://schema.stage.datacite.org/linked-data/property/alternateIdentifier",
  "@type": "rdf:Property",
  "rdfs:label": "alternateIdentifier",
  "rdfs:comment": "An identifier or identifiers other than the primary Identifier applied to the resource being registered. This may be any alphanumeric string unique within its domain of issue, such as a local identifier, a serial number of an instrument, or an inventory number.",
  "rdfs:range": {
    "@id": "https://schema.stage.datacite.org/linked-data/class/AlternateIdentifier"
  },
  "skos:scopeNote": "In RDF, this property links the resource to a AlternateIdentifier node; the node gives the identifier with rdf:value and holds the element's qualifiers (type, scheme, language) alongside it."
}
