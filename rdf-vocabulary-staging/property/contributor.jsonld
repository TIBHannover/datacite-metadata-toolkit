  "@id": "https://w3id.org/tib/datacite/property/contributor",
  "@type": "rdf:Property",
  "rdfs:label": "contributor",
  "rdfs:comment": "The institution or person responsible for collecting, managing, distributing, or otherwise contributing to the development of the resource. To supply multiple contributors, repeat this property.",
  "rdfs:range": {
    "@id": "https://w3id.org/tib/datacite/class/Contributor"
  },
  "skos:scopeNote": "In RDF, this property links the resource to a Contributor node; the node gives the name with contributorName, alongside its contributorType, nameType, nameIdentifier and affiliation."
