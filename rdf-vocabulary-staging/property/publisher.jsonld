  "@id": "https://w3id.org/tib/datacite/property/publisher",
  "@type": "rdf:Property",
  "rdfs:label": "publisher",
  "rdfs:comment": "The name of the entity that holds, archives, publishes, prints, distributes, releases, issues, or produces the resource. This property will be used to formulate the citation, so consider the prominence of the role.",
  "rdfs:range": {
    "@id": "https://w3id.org/tib/datacite/class/Publisher"
  },
  "skos:scopeNote": "In RDF, this property links the resource to a Publisher node; the node gives the publisher name in rdf:value (with a language tag when the record gives one), alongside its publisherIdentifier and scheme."
