  "@id": "https://w3id.org/tib/datacite/property/title",
  "@type": "rdf:Property",
  "rdfs:label": "title",
  "rdfs:comment": "A name or title by which a resource is known. May be the title of a dataset or the name of a piece of software or an instrument.",
  "rdfs:range": {
    "@id": "https://w3id.org/tib/datacite/class/Title"
  },
  "skos:scopeNote": "In RDF, this property links the resource to a Title node; the node gives the title text in rdf:value (with a language tag when the record gives one), alongside its titleType."
